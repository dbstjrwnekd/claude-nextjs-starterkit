{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(npx:*)",
      "Bash(gh repo:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(npm run:*)",
      "Skill(git:commit)",
      "Bash(find /Users/kakao/.claude -name *.md)",
      "Bash(afplay --help)",
      "Bash(afplay:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          },
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code 작업이 완료되었습니다\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  },
  "language": "korean"
}
